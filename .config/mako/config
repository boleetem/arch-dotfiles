# ~/.config/mako/config

sort=-time
layer=overlay
anchor=top-right
margin=10
padding=12

width=320
height=110
border-size=2
border-radius=6

font=JetBrains Mono 10
default-timeout=6000
ignore-timeout=1
icons=1
max-icon-size=48

background-color=#030905
text-color=#C9CDD3
border-color=#529e2c


[urgency=low]
background-color=#030905
text-color=#C9CDD3
border-color=#529e2c
default-timeout=3000

[urgency=normal]
background-color=#030905
text-color=#C9CDD3
border-color=#529e2c

[urgency=high]
background-color=#030905
text-color=#C9CDD3
border-color=#529e2c
default-timeout=0

[mode=dnd]
invisible=1
