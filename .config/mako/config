# ~/.config/mako/config

sort=-time
layer=overlay
anchor=top-right
margin=10
padding=12

width=320
height=110
border-size=2
border-radius=6

font=JetBrains Mono 10
default-timeout=6000
ignore-timeout=1
icons=1
max-icon-size=48

background-color=#0A0D12F2
text-color=#C9CDD3
border-color=#EB7F00

[urgency=low]
background-color=#0A0D12F2
text-color=#5C6470
border-color=#7A4400
default-timeout=3000

[urgency=normal]
background-color=#0A0D12F2
text-color=#C9CDD3
border-color=#EB7F00

[urgency=high]
background-color=#0F0A0AF2
text-color=#E8E6E3
border-color=#FF9E33
default-timeout=0

[mode=dnd]
invisible=1
